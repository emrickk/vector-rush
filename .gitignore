# Local Editor build/licensing logs are not distribution evidence.
evidence/**/unity-*.log
evidence/environment-v3/*.log

# Generated by Unity performance-test build hooks, not authored assets.
UnityProject/Assets/Resources/PerformanceTestRun*.json*

# Duplicate anchor snapshots; reviewed originals live in selected/.
evidence/nocturne-v2/**/full-lap/*.png

# Python validation bytecode is local cache.
__pycache__/

# Production editor/diagnostic logs may include local licensing details.
evidence/nocturne-production/**/*.log

# Integrated-experience raw capture streams stay local; compact reports and
# selected review images are committed explicitly.
artifacts/integrated-racing-experience/**/*.log
artifacts/integrated-racing-experience/**/frames/
artifacts/integrated-racing-experience/**/*.f32
artifacts/integrated-racing-experience/**/*.ffconcat
artifacts/integrated-racing-experience/**/*.mp4
