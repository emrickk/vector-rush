artifacts/integrated-racing-experience/a01-scene-upgrade-01/
artifacts/integrated-racing-experience/a01-integration-tests/focused-results.xml

# Stage 1 native review media, captures, build and licensing logs remain local.
/artifacts/stage1-reference-match/

# Building-pass native candidates and local evidence.
/artifacts/architecture/
/artifacts/architecture-*.log

# City illumination native candidates, logs and local evidence.
/artifacts/city-light/
/artifacts/city-light-*.log

# Portable current-game publication excludes generated/local-only outputs.
/artifacts/neon/
/artifacts/neon-*.log
